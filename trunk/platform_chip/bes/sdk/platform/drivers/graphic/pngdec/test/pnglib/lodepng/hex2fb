import os
import sys
from struct import*

def hex_bytes(hexfile,bfile):
    fin = open(hexfile)
    fout = open(bfile,"wb")
    #discard first line
    fin.readline()
    for hexstr in fin.readlines():
        hexstr = hexstr.strip()
        
        b = hexstr.decode('hex')
        #b = bytes.fromhex(hexstr)
        fout.write(b)

hex_bytes(sys.argv[1],sys.argv[2])
