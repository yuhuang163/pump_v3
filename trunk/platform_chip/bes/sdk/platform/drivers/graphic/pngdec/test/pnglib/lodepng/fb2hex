import os
import sys
from struct import*

def hex_bytes(bfile,hexfile):
    fin = open(bfile,mode='rb')
    fout = open(hexfile,"w")
    hexs = fin.read();
    len = fin.tell()
    i = 0
    while len > 0:
        
        v = hexs[i].encode(encoding='hex') 
        fout.write('0x')
        fout.write(v)
        fout.write(',')
        fout.write("\n")
   
        i += 1
        len -=1

hex_bytes(sys.argv[1],sys.argv[2])
