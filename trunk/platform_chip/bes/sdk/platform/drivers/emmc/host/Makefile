export EMMC_TEST			?= 0
export EMMC_USE_HEAP		?= 0
export EMMC_COMPILE_HEAP	?= 0

ifeq ($(EMMC_TEST),1)
export EMMC_CARD_TEST	?=1
else
export EMMC_CARD_TEST	?=0
endif
export EMMC_USE_STDLIB	?=0
export EMMC_REL_TOPDIR	:= platform/drivers/emmc/host

obj-y += card/ core/ hci/
ifeq ($(EMMC_CARD_TEST),1)
obj-y += test/
endif

export EMMC_CFLAGS :=

ifeq ($(EMMC_TEST),1)
EMMC_CFLAGS += -DEMMC_TEST
ifeq ($(EMMC_TEST_WAIT),1)
EMMC_CFLAGS += -DEMMC_TEST_WAIT
endif
ifeq ($(EMMC_CLOCK_OUTPUT),1)
EMMC_CFLAGS += -DEMMC_CLOCK_OUTPUT
endif
ifeq ($(EMMC_STRESS_TEST),1)
EMMC_CFLAGS += -DEMMC_STRESS_TEST
endif
endif #EMMC_TEST

ifeq ($(EMMC_HS_MODE),1)
EMMC_CFLAGS += -DEMMC_HS_MODE
endif

ifeq ($(EMMC_DDR_MODE),1)
EMMC_CFLAGS += -DEMMC_DDR_MODE
endif

ifeq ($(EMMC_CLOCK_REVERSE),1)
EMMC_CFLAGS += -DEMMC_CLOCK_REVERSE
endif

ifeq ($(EMMC_USE_HEAP),1)
EMMC_CFLAGS += -DEMMC_USE_HEAP
ifeq ($(EMMC_COMPILE_HEAP),1)
EMMC_CFLAGS += -DEMMC_COMPILE_HEAP
obj-y += ../../../../utils/heap/
endif
endif #EMMC_USE_HEAP

ifeq ($(EMMC_DEBUG),1)
EMMC_CFLAGS += -DEMMC_DEBUG
endif

ifeq ($(EMMC_ASSERT),1)
EMMC_CFLAGS += -DEMMC_ASSERT
endif

ifeq ($(EMMC_EXTENDED_USE),1)
EMMC_CFLAGS += -DEMMC_EXTENDED_USE
endif

ifeq ($(EMMC_USE_PLL),1)
EMMC_CFLAGS += -DEMMC_USE_PLL
endif

ifneq ($(BBPLL_MHZ),)
EMMC_CFLAGS += -DBBPLL_MHZ=$(BBPLL_MHZ)
endif

ifneq ($(DSIPLL_MHZ),)
EMMC_CFLAGS += -DDSIPLL_MHZ=$(DSIPLL_MHZ)
endif

ifeq ($(EMMC_HS400_SYSFREQ_RAISE),1)
EMMC_CFLAGS += -DEMMC_HS400_SYSFREQ_RAISE
endif

ifneq ($(EMMC_ADMA_DESC_CNT),)
EMMC_CFLAGS += -DEMMC_ADMA_DESC_CNT=$(EMMC_ADMA_DESC_CNT)
endif

ifeq ($(EMMC_RPMB_ENABLE),1)
EMMC_CFLAGS += -DEMMC_RPMB_ENABLE
endif

ifeq ($(EMMC_RUN_RECORD),1)
EMMC_CFLAGS += -DEMMC_RUN_RECORD
endif

ifneq ($(EMMC_RUN_RECORD_CNT),)
EMMC_CFLAGS += -DEMMC_RUN_RECORD_CNT=$(EMMC_RUN_RECORD_CNT)
endif
